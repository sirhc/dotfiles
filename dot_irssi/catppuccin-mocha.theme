# Catppuccin Mocha for irssi
# Adapted from https://github.com/bitspace/catppuccin-irssi

default_color = "-1";
info_eol = "false";

replaces = {
  "[]=" = "%Z6c7086$*%n";
};

abstracts = {
  line_start = "";
  timestamp = "%Z6c7086$*%n";
  hilight = "%Zf5e0dc$*%n";
  error = "%Zf38ba8$*%n";
  channel = "%Z89b4fa$*%n";
  nick = "%Zb4befe$*%n";
  nickhost = "%Z7f849c$*%n";
  server = "%Zcba6f7$*%n";
  comment = "%Z7f849c$*%n";
  reason = "{comment $*}";
  mode = "%Zf9e2af$*%n";

  channick_hilight = "%Za6e3a1$*%n";
  chanhost_hilight = "{nickhost $*}";
  channick = "%Z89dceb$*%n";
  chanhost = "{nickhost $*}";
  channelhilight = "%Zcba6f7$*%n";
  ban = "%Zf38ba8$*%n";

  msgnick = "%Z9399b2<%n$0$1%Z9399b2>%n %|";
  ownmsgnick = "{msgnick $0 $1-}";
  ownnick = "%Za6e3a1$*%n";
  pubmsgnick = "{msgnick $0 $1-}";
  pubnick = "%Z89b4fa$*%n";
  pubmsgmenick = "{msgnick $0 $1-}";
  menick = "%Zf5e0dc$*%n";
  pubmsghinick = "{msgnick $1 $0$2-%n}";
  msgchannel = "%Z9399b2:%Zcba6f7$*%n";

  privmsg = "%Z9399b2[%Zf5e0dc$0%Z9399b2(%Zbac2de$1-%Z9399b2)%n] ";
  ownprivmsg = "%Z9399b2[%Za6e3a1$0%Z9399b2(%Zb4befe$1-%Z9399b2)%n] ";
  ownprivmsgnick = "{msgnick $*}";
  ownprivnick = "%Za6e3a1$*%n";
  privmsgnick = "{msgnick %Zf5e0dc$*%n}";

  action_core = "%Zfab387* %Zcdd6f4$*%n";
  action = "{action_core $*} ";
  ownaction = "{action $*}";
  ownaction_target = "{action_core $0}%Z9399b2:%Zcba6f7$1%n ";
  pvtaction = "%Zfab387(*) %Zcdd6f4$*%n ";
  pvtaction_query = "{action $*}";
  pubaction = "{action $*}";

  whois = "%Z7f849c$[8]0 %Z9399b2:%Zcdd6f4 $1-%n";
  ownnotice = "%Z9399b2[%Zf9e2af$0%Z9399b2(%Zbac2de$1-%Z9399b2)%n] ";
  notice = "%Z9399b2-%Zf9e2af$*%Z9399b2-%n ";
  pubnotice_channel = "%Z9399b2:%Zf9e2af$*%n";
  pvtnotice_host = "%Z9399b2(%Zf9e2af$*%Z9399b2)%n";
  servernotice = "%Z94e2d5$*%n ";
  ownctcp = "%Z9399b2[%Zf5c2e7$0%Z9399b2(%Zbac2de$1-%Z9399b2)%n] ";
  ctcp = "%Zf5c2e7$*%n";
  wallop = "%Zf38ba8$*%n: ";
  wallop_nick = "%Zcdd6f4$*%n";
  wallop_action = "%Zf38ba8* %Zcdd6f4$*%n ";
  netsplit = "%Zf38ba8$*%n";
  netjoin = "%Za6e3a1$*%n";

  names_prefix = "";
  names_nick = "%Z9399b2[%Zcdd6f4$0$1-%Z9399b2]%n ";
  names_nick_op = "{names_nick %Zf9e2af$0%n $1-}";
  names_nick_halfop = "{names_nick %Z94e2d5$0%n $1-}";
  names_nick_voice = "{names_nick %Za6e3a1$0%n $1-}";
  names_users = "%Z9399b2[%Zcdd6f4$*%Z9399b2]%n";
  names_channel = "%Z89b4fa$*%n";

  dcc = "%Zfab387$*%n";
  dccfile = "%Z89b4fa$*%n";
  dccownmsg = "%Z9399b2[%Za6e3a1$0%Z9399b2(%Zbac2de$1-%Z9399b2)%n] ";
  dccownnick = "%Za6e3a1$*%n";
  dccownquerynick = "%Za6e3a1$*%n";
  dccownaction = "{action $*}";
  dccownaction_target = "{action_core $0}%Z9399b2:%Zcba6f7$1%n ";
  dccmsg = "%Z9399b2[%Z89dceb$1-%Z9399b2(%Zbac2de$0%Z9399b2)%n] ";
  dccquerynick = "%Z89dceb$*%n";
  dccaction = "%Zfab387(*dcc*) %Zcdd6f4$*%n %|";

  sb_background = "%z181825%Zcdd6f4";
  sb_prompt_bg = "%z1e1e2e%Zcdd6f4";
  sb_info_bg = "%z313244%Zcdd6f4";
  sbstart = "";
  sbend = " ";
  topicsbstart = "{sbstart $*}";
  topicsbend = "{sbend $*}";
  prompt = "%Z9399b2[%Zb4befe$*%Z9399b2]%n ";
  sb = " %Z9399b2[%Zcdd6f4$*%Z9399b2]%n";
  sbmode = "%Z9399b2(%Zf9e2af+%n$*%Z9399b2)%n";
  sbaway = " %Z9399b2(%Zfab387away%Z9399b2)%n";
  sbservertag = "%Z9399b2:%Zcba6f7$0%n";
  sbnickmode = "$0";

  sb_act_sep = "%Z7f849c$*%n";
  sb_act_text = "%Z7f849c$*%n";
  sb_act_msg = "%Z89b4fa$*%n";
  sb_act_hilight = "%Zf5e0dc$*%n";
  sb_act_hilight_color = "$0$1-%n";
};

formats = {
  "fe-common/core" = {
    timestamp = "{timestamp %%H:%%M} ";
  };
};
