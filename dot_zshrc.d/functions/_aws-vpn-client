#compdef aws-vpn-client

local ret=1
local -a commands=(
    'connect:Connect a profile through the AWS VPN Client'
    'disconnect:Disconnect a profile from the AWS VPN Client'
    'delete-profile:Delete a profile from the AWS VPN Client'
    'import-profile:Import a VPN connection profile'
    'list-profiles:List all VPN profiles'
    'get-config:Get configuration for a profile'
    'put-preference:Put a preference value'
    'list-preferences:List all preferences'
    'get-connection-status:Get the current connection status for a VPN profile'
    'list-connections:List all active VPN connections'
    'send-diagnostic-logs:Send diagnostic logs to AWS for troubleshooting'
    'help:Print this message or the help of the given subcommand(s)'
)

_arguments -C \
    '(-h --help)'{-h,--help}'[Print help]' \
    '(-V --version)'{-V,--version}'[Print version]' \
    '1: :->command' \
    '*::arg:->args' && ret=0

case $state in
    (command)
        _describe -t commands 'aws-vpn-client command' commands && ret=0
        ;;
    (args)
        case ${line[1]} in
            (connect)
                _arguments \
                    '--profile-name=[Name of the profile]:profile:->profile' \
                    '--auth-user-pass=[Path to file containing username, password, and optional MFA code]:file:_files' \
                    '(-h --help)'{-h,--help}'[Print help]' && ret=0
                ;;
            (disconnect)
                _arguments \
                    '--profile-name=[Name of the profile]:profile:->connected-profile' \
                    '(-h --help)'{-h,--help}'[Print help]' && ret=0
                ;;
            (delete-profile|get-config)
                _arguments \
                    '--profile-name=[Name of the profile]:profile:->profile' \
                    '(-h --help)'{-h,--help}'[Print help]' && ret=0
                ;;
            (import-profile)
                _arguments \
                    '--profile-name=[Name of the profile]:name' \
                    '--config-path=[Path to the configuration file]:file:_files' \
                    '--global[Make the profile available to all users]' \
                    '(-h --help)'{-h,--help}'[Print help]' && ret=0
                ;;
            (get-connection-status)
                _arguments \
                    '--profile-name=[Name of the profile]:profile:->profile' \
                    '--show-details[Include connection byte statistics in the output]' \
                    '(-h --help)'{-h,--help}'[Print help]' && ret=0
                ;;
            (put-preference)
                _arguments \
                    '--key=[Name of the preference]:key' \
                    '--value=[Value of the preference]:value' \
                    '(-h --help)'{-h,--help}'[Print help]' && ret=0
                ;;
            (list-profiles|list-preferences|list-connections|send-diagnostic-logs)
                _arguments '(-h --help)'{-h,--help}'[Print help]' && ret=0
                ;;
            (help)
                _describe -t commands 'aws-vpn-client command' commands && ret=0
                ;;
        esac

        case $state in
            (profile)
                local -a profiles=("${(f)"$(aws-vpn-client list-profiles 2>/dev/null | jq -r '.[]."profile-name"')"}")
                _wanted profiles expl profile compadd -a profiles && ret=0
                ;;
            (connected-profile)
                local -a profiles=("${(f)"$(aws-vpn-client list-connections 2>/dev/null | jq -r '.[]."profile-name"')"}")
                _wanted profiles expl profile compadd -a profiles && ret=0
                ;;
        esac
        ;;
esac

return ret
