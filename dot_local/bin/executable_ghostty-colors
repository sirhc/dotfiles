#!/usr/bin/env bash
# Render the color palette of the active Ghostty theme as swatches, in columns.
set -euo pipefail

columns=8

mapfile -t entries < <(ghostty +show-config | awk -F'= ' '/^palette = / { print $2 }')

count=0
for entry in "${entries[@]}"; do
  index=${entry%%=*}
  hex=${entry#*=}
  hex=${hex#\#}
  r=$((16#${hex:0:2}))
  g=$((16#${hex:2:2}))
  b=$((16#${hex:4:2}))
  printf '\033[48;2;%d;%d;%dm  \033[0m %3d #%s  ' "$r" "$g" "$b" "$index" "$hex"
  count=$((count + 1))
  (( count % columns == 0 )) && printf '\n'
done
(( count % columns != 0 )) && printf '\n'
