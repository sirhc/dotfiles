# vim: ft=config
# https://jonas.github.io/tig/doc/tigrc.5.html

set line-graphics = auto
set truncation-delimiter = utf-8
# set ignore-space = some
set ignore-case = smart-case
set mailmap = true
set editor-line-number = true

# Color overrides for Tango Soft Dark: default cursor/title-bar use warm
# off-white text with too little contrast against green/blue backgrounds.
color cursor            color0  color2  bold
color cursor-blur       color7  color8
color title-focus       color0  color4  bold
color title-blur        color0  color4

bind main R !?git revert %(commit)
bind diff R !?git revert %(commit)

# https://stackoverflow.com/a/25975171
bind diff 7 !git diff %(commit)^ %(commit)
